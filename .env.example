# Agenda de Skin Era conectada a Google Calendar (netlify/functions/agenda.mjs).
# Copia este archivo como .env para desarrollo, o pega estas variables en
# Netlify > Site configuration > Environment variables.
# Nunca subas los valores reales a GitHub.

# Correo de la cuenta de servicio, termina en .iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Campo "private_key" del archivo JSON de la cuenta de servicio, entre comillas
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID del calendario donde caen las citas (en Google Calendar: Configuración del
# calendario > Integrar calendario > ID de calendario)
GOOGLE_CALENDAR_ID=

# Solo en tu computadora: la agenda usa horarios de ejemplo y NO crea citas reales.
# `npm run dev` ya lo activa solo si no hay credenciales. Se ignora dentro de Netlify.
# AGENDA_DEMO=1
